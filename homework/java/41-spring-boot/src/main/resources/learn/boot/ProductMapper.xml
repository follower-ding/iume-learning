<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="learn.boot.ProductMapper">
    <resultMap id="productMap" type="learn.boot.Product">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="price" column="price"/>
    </resultMap>
    <select id="findById" resultMap="productMap">SELECT id, name, price FROM products WHERE id = #{id}</select>
    <select id="findByName" resultMap="productMap">SELECT id, name, price FROM products WHERE name = #{name}</select>
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">INSERT INTO products (name, price) VALUES (#{name}, #{price})</insert>
    <update id="update">UPDATE products SET name = #{name}, price = #{price} WHERE id = #{id}</update>
    <delete id="delete">DELETE FROM products WHERE id = #{id}</delete>
</mapper>
